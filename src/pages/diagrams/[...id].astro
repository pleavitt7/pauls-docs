---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageToc from '../../components/PageToc.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const diagrams = await getCollection('diagrams');

  return diagrams.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'diagrams'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;
const diagramUrl = `${base}${entry.data.diagram}`;
const homeUrl = base;
const formattedDate = entry.data.date.toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<SiteLayout title={`${entry.data.title} · Paul's docs`} description={entry.data.summary}>
  <main>
    <a class="back-link" href={homeUrl}>← All diagrams</a>

    <header class="diagram-header">
      <div>
        <p class="eyebrow">Architecture plate · {String(entry.data.order).padStart(2, '0')}</p>
        <h1>{entry.data.title}</h1>
      </div>
      <div class="metadata">
        <p>{formattedDate}</p>
        <p>{entry.data.tags.join(' · ')}</p>
      </div>
    </header>

    <div class="page-grid">
      <article>
        <div class="diagram-preview">
          <iframe
            src={diagramUrl}
            title={`${entry.data.title} diagram`}
            loading="eager"
          ></iframe>
        </div>
        <a class="mobile-open" href={diagramUrl}>Open responsive diagram <span aria-hidden="true">↗</span></a>

        <div class="prose">
          <Content />
        </div>
      </article>

      <aside>
        <PageToc headings={headings} />
      </aside>
    </div>
  </main>
</SiteLayout>

<style>
  main { padding-top: 28px; }

  .back-link {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    color: #5f6671;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .diagram-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: 40px;
    align-items: end;
    padding: 22px 0 30px;
    border-bottom: 1px solid rgba(34, 38, 46, 0.42);
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #c64e32;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 22ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.75rem, 5vw, 4.75rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .metadata {
    padding-top: 12px;
    border-top: 1px solid rgba(34, 38, 46, 0.18);
  }

  .metadata p {
    margin: 0;
    color: #5f6671;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.6875rem;
    line-height: 1.65;
  }

  .page-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 38px;
    padding-top: 34px;
  }

  article,
  aside { min-width: 0; }

  .diagram-preview {
    height: min(76vh, 980px);
    min-height: 660px;
    border-top: 1px solid #22262e;
    border-bottom: 1px solid rgba(34, 38, 46, 0.42);
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: #f2efe8;
  }

  .mobile-open { display: none; }

  .prose {
    max-width: 76ch;
    padding: 36px 0 72px;
    color: #404650;
  }

  .prose :global(h2) {
    margin: 42px 0 14px;
    padding-top: 18px;
    border-top: 1px solid rgba(34, 38, 46, 0.18);
    color: #22262e;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .prose :global(h2:first-child) { margin-top: 0; }

  .prose :global(p) {
    margin: 0 0 18px;
    font-size: 1rem;
    line-height: 1.75;
  }

  .prose :global(code) {
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.875em;
  }

  @media (max-width: 900px) {
    .page-grid { grid-template-columns: 1fr; gap: 28px; }
    aside { grid-row: 1; }
  }

  @media (max-width: 760px) {
    main { padding-top: 18px; }
    .diagram-header { grid-template-columns: 1fr; gap: 24px; }
    h1 { font-size: 3rem; }
    .diagram-preview { display: none; }
    .mobile-open {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      min-height: 64px;
      padding: 20px 0;
      align-items: center;
      border-top: 1px solid #22262e;
      border-bottom: 1px solid rgba(34, 38, 46, 0.42);
      color: #22262e;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
    }
    .prose { padding-top: 28px; }
    .prose :global(p) { font-size: 1rem; }
  }
</style>
