---
import { getCollection } from 'astro:content';
import DiagramCatalogue from '../components/DiagramCatalogue.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const diagrams = (await getCollection('diagrams')).sort((a, b) => {
  return a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime();
});
---

<SiteLayout
  title="Home Infrastructure"
  description="Architecture diagrams and notes for Paul's home infrastructure."
>
  <main>
    <section class="hero" aria-labelledby="page-title">
      <div class="kicker">
        <span>Home infrastructure</span>
        <span>System notes and diagrams</span>
      </div>
      <div class="hero-grid">
        <h1 id="page-title">Architecture<br />plates</h1>
        <p>
          A growing static record of the services running on the home NUC.
          Add a Markdown entry to the diagram collection and it appears in this catalogue automatically.
        </p>
      </div>
    </section>

    <section class="contents-section" aria-labelledby="contents-title">
      <h2 id="contents-title" class="visually-hidden">Diagram contents</h2>
      <DiagramCatalogue entries={diagrams} />
    </section>
  </main>
</SiteLayout>

<style>
  main { padding-top: 34px; }

  .hero {
    padding: 24px 0 38px;
    border-bottom: 1px solid rgba(34, 38, 46, 0.42);
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    color: #5f6671;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .kicker span:first-child { color: #c64e32; }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
    gap: 48px;
    align-items: end;
    padding-top: 24px;
  }

  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 6vw, 5.75rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .hero-grid p {
    max-width: 46ch;
    margin: 0;
    color: #5f6671;
    font-size: 1rem;
    line-height: 1.65;
  }

  .contents-section { padding-top: 36px; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    main { padding-top: 20px; }
    .hero { padding-top: 16px; }
    .hero-grid { grid-template-columns: 1fr; gap: 22px; }
    h1 { font-size: 3.5rem; }
    .hero-grid p { font-size: 1rem; }
    .contents-section { padding-top: 28px; }
  }
</style>
