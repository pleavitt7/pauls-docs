---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const homeUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-name" href={homeUrl}>Paul's docs</a>
        <p>Home infrastructure · diagrams and notes</p>
      </header>
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    color: #22262e;
    background: #f2efe8;
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    font-synthesis: none;
  }

  * { box-sizing: border-box; }
  html { min-width: 0; }
  body { margin: 0; }

  .site-shell {
    width: min(100%, 1500px);
    margin: 0 auto;
    padding: 34px;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: baseline;
    padding: 14px 0;
    border-top: 3px solid #22262e;
    border-bottom: 1px solid rgba(34, 38, 46, 0.42);
  }

  .site-name {
    color: #c64e32;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-header p {
    margin: 0;
    color: #5f6671;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  a { text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid #c64e32; outline-offset: 4px; }

  @media (max-width: 760px) {
    .site-shell { padding: 22px 20px; }
    .site-header { display: grid; gap: 6px; }
    .site-name { min-height: 48px; display: inline-flex; align-items: center; }
    .site-header p { font-size: 0.75rem; line-height: 1.5; }
  }
</style>
