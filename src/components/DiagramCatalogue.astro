---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'diagrams'>[];
}

const { entries } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="catalogue" aria-label="Diagram catalogue">
  <div class="catalogue-heading">
    <h2>Contents</h2>
    <p>{entries.length} {entries.length === 1 ? 'diagram' : 'diagrams'}</p>
  </div>
  <ol class="catalogue-list" role="list">
    {entries.map((entry, index) => (
      <li>
        <a href={`${base}diagrams/${entry.id}/`}>
          <span class="catalogue-number">{String(index + 1).padStart(2, '0')}</span>
          <span class="catalogue-copy">
            <strong>{entry.data.title}</strong>
            <span>{entry.data.summary}</span>
            <span class="catalogue-tags">{entry.data.tags.join(' · ')}</span>
          </span>
          <span class="catalogue-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .catalogue { border-top: 1px solid #22262e; }

  .catalogue-heading {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(34, 38, 46, 0.18);
  }

  .catalogue-heading h2,
  .catalogue-heading p {
    margin: 0;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .catalogue-heading p { color: #5f6671; }

  .catalogue-list { margin: 0; padding: 0; list-style: none; }
  li { border-bottom: 1px solid rgba(34, 38, 46, 0.18); }

  a {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 24px;
    gap: 16px;
    min-height: 128px;
    padding: 22px 0;
    color: #22262e;
    text-decoration: none;
  }

  a:hover strong { color: #c64e32; }

  .catalogue-number,
  .catalogue-tags {
    color: #7b818a;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.6875rem;
  }

  .catalogue-copy { min-width: 0; }

  .catalogue-copy strong {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .catalogue-copy > span:not(.catalogue-tags) {
    display: block;
    max-width: 68ch;
    margin-top: 10px;
    color: #5f6671;
    font-size: 1rem;
    line-height: 1.55;
  }

  .catalogue-tags { display: block; margin-top: 12px; }
  .catalogue-arrow { font-size: 1.125rem; text-align: right; }

  @media (max-width: 620px) {
    a { grid-template-columns: 28px minmax(0, 1fr); min-height: 0; }
    .catalogue-arrow { display: none; }
    .catalogue-copy strong { font-size: 1.75rem; }
  }
</style>
