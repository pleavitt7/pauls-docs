---
import { getCollection } from 'astro:content';
import { LinkCard } from '@astrojs/starlight/components';

const base = import.meta.env.BASE_URL;
const diagrams = (await getCollection('docs'))
  .filter((entry) => entry.id.startsWith('diagrams/') && !entry.data.draft)
  .sort((a, b) => {
    return (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
      || (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0);
  });
---

<div class="diagram-catalogue" aria-label="Architecture diagrams">
  {diagrams.map((entry) => (
    <LinkCard
      href={`${base}${entry.id}/`}
      title={entry.data.title}
      description={entry.data.description}
    />
  ))}
</div>

<style>
  .diagram-catalogue {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }
</style>
