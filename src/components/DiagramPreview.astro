---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
const base = import.meta.env.BASE_URL;
const diagramUrl = `${base}${src}`;
const embedUrl = `${diagramUrl}?embed=1`;
---

<div class="diagram-preview">
  <iframe
    data-diagram-frame
    src={embedUrl}
    title={`${title} diagram`}
    loading="eager"
  ></iframe>
</div>
<a class="mobile-open" href={diagramUrl}>
  Open responsive diagram <span aria-hidden="true">↗</span>
</a>

<script is:inline>
  (() => {
    const frames = document.querySelectorAll('[data-diagram-frame]');
    const readTokens = () => {
      const styles = getComputedStyle(document.documentElement);
      const fallback = getComputedStyle(document.body).fontFamily;
      const system = styles.getPropertyValue('--sl-font-system').trim() || fallback;
      const mono = styles.getPropertyValue('--sl-font-system-mono').trim() || 'monospace';

      return {
        '--sans': styles.getPropertyValue('--sl-font').trim() || system,
        '--mono': styles.getPropertyValue('--sl-font-mono').trim() || mono,
      };
    };

    const sendTheme = (frame) => {
      frame.contentWindow?.postMessage(
        {
          type: 'diagram-theme',
          theme: document.documentElement.dataset.theme === 'light' ? 'light' : 'dark',
          fonts: readTokens(),
        },
        window.location.origin,
      );
    };

    frames.forEach((frame) => {
      frame.addEventListener('load', () => sendTheme(frame));
      sendTheme(frame);
    });

    const themeObserver = new MutationObserver(() => {
      frames.forEach(sendTheme);
    });

    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  })();
</script>

<style>
  .diagram-preview {
    width: 100%;
    aspect-ratio: 1280 / 700;
    max-height: 700px;
    margin-block: 1.5rem 2rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: min(1vw, 0.5rem);
    background: var(--sl-color-bg);
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--sl-color-bg);
    color-scheme: light dark;
  }

  .mobile-open { display: none; }

  @media (max-width: 50rem) {
    .diagram-preview { display: none; }

    .mobile-open {
      display: flex;
      min-height: 3rem;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-block: 1.5rem 2rem;
      padding: 0.875rem 1rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: min(2vw, 0.5rem);
      background: var(--sl-color-bg-nav);
      color: var(--sl-color-text-accent);
      font-weight: 600;
      text-decoration: none;
    }
  }
</style>
