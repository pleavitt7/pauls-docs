---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const headings = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{headings.length > 0 && (
  <nav class="page-toc" aria-label="On this page">
    <p>On this page</p>
    <ol class="toc-list" role="list">
      {headings.map((heading) => (
        <li class:list={{ nested: heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .page-toc {
    position: sticky;
    top: 24px;
    border-top: 1px solid #22262e;
  }

  p {
    margin: 0;
    padding: 13px 0;
    border-bottom: 1px solid rgba(34, 38, 46, 0.18);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .toc-list { margin: 0; padding: 0; list-style: none; }

  li { border-bottom: 1px solid rgba(34, 38, 46, 0.12); }
  li.nested a { padding-left: 18px; }

  a {
    display: block;
    min-height: 48px;
    padding: 14px 0;
    color: #5f6671;
    font-size: 0.875rem;
    line-height: 1.4;
    text-decoration: none;
  }

  a:hover { color: #c64e32; }

  @media (max-width: 900px) {
    .page-toc { position: static; }
    .toc-list { display: flex; overflow-x: auto; scrollbar-width: thin; }
    li { flex: 0 0 auto; border-right: 1px solid rgba(34, 38, 46, 0.12); }
    a { padding: 14px 18px; font-size: 1rem; white-space: nowrap; }
  }
</style>
